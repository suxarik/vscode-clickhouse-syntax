{
  "name": "clickhouse-syntax",
  "displayName": "ClickHouse SQL Syntax",
  "description": "ClickHouse SQL for VS Code: a real parser and scope binder, a catalog generated from ClickHouse itself, and a connection that lets you run, explain and profile queries in place.",
  "version": "2.0.0",
  "publisher": "SuXarikisme",
  "icon": "images/clickhouse.png",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets",
    "Linters",
    "Data Science"
  ],
  "keywords": [
    "clickhouse",
    "sql",
    "database",
    "syntax",
    "highlight",
    "intellisense",
    "completion",
    "hover",
    "diagnostics",
    "formatter"
  ],
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suxarik/vscode-clickhouse-syntax.git"
  },
  "homepage": "https://github.com/suxarik/vscode-clickhouse-syntax#readme",
  "bugs": {
    "url": "https://github.com/suxarik/vscode-clickhouse-syntax/issues"
  },
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:clickhouse",
    "onView:clickhouseExplorer"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "clickhouse",
        "aliases": [
          "ClickHouse SQL",
          "clickhouse",
          "chsql"
        ],
        "extensions": [
          ".chsql",
          ".ch.sql"
        ],
        "firstLine": "^--\\s*(clickhouse|ClickHouse)",
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/clickhouse.png",
          "dark": "./images/clickhouse.png"
        }
      }
    ],
    "commands": [
      {
        "command": "clickhouse.detectLanguage",
        "title": "Detect & Set ClickHouse SQL Language",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.formatDocument",
        "title": "Format ClickHouse SQL",
        "category": "ClickHouse",
        "icon": "$(symbol-keyword)"
      },
      {
        "command": "clickhouse.reloadSchema",
        "title": "Reload Schema",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.validateSchema",
        "title": "Validate Schema",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.generateSchemaTemplate",
        "title": "Generate Schema Template",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.toggleLanguage",
        "title": "Toggle ClickHouse SQL / SQL for This File",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.showCatalogInfo",
        "title": "Show Catalog Info",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.showLintRules",
        "title": "Show Lint Rules",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.selectConnection",
        "title": "Select Connection",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.testConnection",
        "title": "Test Connection",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.setConnectionPassword",
        "title": "Set Connection Password",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.clearConnectionPassword",
        "title": "Clear Connection Password",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.runQuery",
        "title": "Run Query",
        "category": "ClickHouse",
        "icon": "$(play)"
      },
      {
        "command": "clickhouse.cancelQuery",
        "title": "Cancel Running Query",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.runStatementAt",
        "title": "Run Statement",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.explainQuery",
        "title": "Explain Query",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.showQueryHistory",
        "title": "Query History",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.clearQueryHistory",
        "title": "Clear Query History",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.profileLastQuery",
        "title": "Profile Last Query",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.validateWithServer",
        "title": "Validate Against Server",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.refreshExplorer",
        "title": "Refresh Explorer",
        "category": "ClickHouse",
        "icon": "$(refresh)"
      },
      {
        "command": "clickhouse.previewTable",
        "title": "Preview 100 Rows",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.showCreateTable",
        "title": "Show CREATE TABLE",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.copyQualifiedName",
        "title": "Copy Qualified Name",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.insertColumnList",
        "title": "Insert Column List",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.insertName",
        "title": "Insert Name",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.selectFromTable",
        "title": "Insert SELECT Statement",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.addConnection",
        "title": "Add Connection",
        "category": "ClickHouse",
        "icon": "$(add)"
      },
      {
        "command": "clickhouse.editConnections",
        "title": "Edit Connections",
        "category": "ClickHouse"
      },
      {
        "command": "clickhouse.removeConnection",
        "title": "Remove Connection",
        "category": "ClickHouse"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "clickhouse.formatDocument",
          "when": "editorTextFocus && (editorLangId == 'clickhouse' || editorLangId == 'sql')",
          "group": "1_modification@10"
        }
      ],
      "commandPalette": [
        {
          "command": "clickhouse.formatDocument",
          "when": "editorLangId == 'clickhouse' || editorLangId == 'sql'"
        },
        {
          "command": "clickhouse.detectLanguage",
          "when": "editorIsOpen"
        },
        {
          "command": "clickhouse.toggleLanguage",
          "when": "editorLangId == 'clickhouse' || editorLangId == 'sql'"
        },
        {
          "command": "clickhouse.reloadSchema",
          "when": "true"
        },
        {
          "command": "clickhouse.validateSchema",
          "when": "true"
        },
        {
          "command": "clickhouse.generateSchemaTemplate",
          "when": "true"
        },
        {
          "command": "clickhouse.showCatalogInfo",
          "when": "true"
        },
        {
          "command": "clickhouse.showLintRules",
          "when": "true"
        },
        {
          "command": "clickhouse.selectConnection",
          "when": "true"
        },
        {
          "command": "clickhouse.testConnection",
          "when": "true"
        },
        {
          "command": "clickhouse.setConnectionPassword",
          "when": "true"
        },
        {
          "command": "clickhouse.clearConnectionPassword",
          "when": "true"
        },
        {
          "command": "clickhouse.runQuery",
          "when": "editorLangId == 'clickhouse' || editorLangId == 'sql'"
        },
        {
          "command": "clickhouse.cancelQuery",
          "when": "editorLangId == 'clickhouse' || editorLangId == 'sql'"
        },
        {
          "command": "clickhouse.runStatementAt",
          "when": "false"
        },
        {
          "command": "clickhouse.explainQuery",
          "when": "true"
        },
        {
          "command": "clickhouse.showQueryHistory",
          "when": "true"
        },
        {
          "command": "clickhouse.clearQueryHistory",
          "when": "true"
        },
        {
          "command": "clickhouse.profileLastQuery",
          "when": "true"
        },
        {
          "command": "clickhouse.validateWithServer",
          "when": "true"
        },
        {
          "command": "clickhouse.refreshExplorer",
          "when": "true"
        },
        {
          "command": "clickhouse.previewTable",
          "when": "false"
        },
        {
          "command": "clickhouse.showCreateTable",
          "when": "false"
        },
        {
          "command": "clickhouse.copyQualifiedName",
          "when": "false"
        },
        {
          "command": "clickhouse.insertColumnList",
          "when": "false"
        },
        {
          "command": "clickhouse.insertName",
          "when": "false"
        },
        {
          "command": "clickhouse.selectFromTable",
          "when": "false"
        },
        {
          "command": "clickhouse.addConnection",
          "when": "true"
        },
        {
          "command": "clickhouse.editConnections",
          "when": "true"
        },
        {
          "command": "clickhouse.removeConnection",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "clickhouse.addConnection",
          "when": "view == clickhouseExplorer",
          "group": "navigation@1"
        },
        {
          "command": "clickhouse.refreshExplorer",
          "when": "view == clickhouseExplorer",
          "group": "navigation@2"
        },
        {
          "command": "clickhouse.selectConnection",
          "when": "view == clickhouseExplorer",
          "group": "1_connection"
        },
        {
          "command": "clickhouse.editConnections",
          "when": "view == clickhouseExplorer",
          "group": "1_connection"
        },
        {
          "command": "clickhouse.removeConnection",
          "when": "view == clickhouseExplorer",
          "group": "1_connection"
        }
      ],
      "view/item/context": [
        {
          "command": "clickhouse.previewTable",
          "when": "view == clickhouseExplorer && viewItem == clickhouse.table",
          "group": "inline"
        },
        {
          "command": "clickhouse.selectFromTable",
          "when": "view == clickhouseExplorer && viewItem == clickhouse.table",
          "group": "1_insert"
        },
        {
          "command": "clickhouse.insertColumnList",
          "when": "view == clickhouseExplorer && viewItem == clickhouse.table",
          "group": "1_insert"
        },
        {
          "command": "clickhouse.insertName",
          "when": "view == clickhouseExplorer && viewItem in clickhouse.insertable",
          "group": "1_insert"
        },
        {
          "command": "clickhouse.showCreateTable",
          "when": "view == clickhouseExplorer && viewItem == clickhouse.table",
          "group": "2_inspect"
        },
        {
          "command": "clickhouse.copyQualifiedName",
          "when": "view == clickhouseExplorer",
          "group": "3_copy"
        }
      ]
    },
    "grammars": [
      {
        "language": "clickhouse",
        "scopeName": "source.sql.clickhouse",
        "path": "./syntaxes/clickhouse.tmLanguage.json"
      },
      {
        "scopeName": "source.sql.clickhouse.injection",
        "path": "./syntaxes/clickhouse-injection.tmLanguage.json",
        "injectTo": [
          "source.sql"
        ]
      }
    ],
    "snippets": [
      {
        "language": "clickhouse",
        "path": "./snippets/clickhouse.json"
      },
      {
        "language": "sql",
        "path": "./snippets/clickhouse.json"
      }
    ],
    "configuration": {
      "title": "ClickHouse SQL",
      "properties": {
        "clickhouse.format.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ClickHouse SQL formatting"
        },
        "clickhouse.format.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "description": "Keyword case for formatting"
        },
        "clickhouse.format.indentSize": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces for indentation"
        },
        "clickhouse.schema.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable schema-aware IntelliSense features"
        },
        "clickhouse.schema.paths": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "default": [
            "./clickhouse-schema.json"
          ],
          "description": "Paths to schema definition files (supports glob patterns)"
        },
        "clickhouse.schema.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reload schema when definition files change"
        },
        "clickhouse.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code completion"
        },
        "clickhouse.completion.includeKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Include SQL keywords in completion suggestions"
        },
        "clickhouse.completion.includeFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Include ClickHouse functions in completion suggestions"
        },
        "clickhouse.completion.includeDataTypes": {
          "type": "boolean",
          "default": true,
          "description": "Include ClickHouse data types in completion suggestions"
        },
        "clickhouse.completion.includeTables": {
          "type": "boolean",
          "default": true,
          "description": "Include tables from schema in completion suggestions"
        },
        "clickhouse.completion.includeColumns": {
          "type": "boolean",
          "default": true,
          "description": "Include columns from schema in completion suggestions"
        },
        "clickhouse.completion.includeQualifiedNames": {
          "type": "boolean",
          "default": true,
          "description": "Include fully qualified names (database.table) in completion suggestions"
        },
        "clickhouse.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover documentation"
        },
        "clickhouse.hover.showTableSchema": {
          "type": "boolean",
          "default": true,
          "description": "Show table schema in hover documentation"
        },
        "clickhouse.hover.showColumnType": {
          "type": "boolean",
          "default": true,
          "description": "Show column type in hover documentation"
        },
        "clickhouse.hover.showFunctionSignature": {
          "type": "boolean",
          "default": true,
          "description": "Show function signature in hover documentation"
        },
        "clickhouse.hover.showExamples": {
          "type": "boolean",
          "default": true,
          "description": "Show examples in hover documentation"
        },
        "clickhouse.signatureHelp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable function signature help"
        },
        "clickhouse.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic error checking and diagnostics"
        },
        "clickhouse.diagnostics.schemaValidation": {
          "type": "boolean",
          "default": true,
          "description": "Enable schema validation (unknown tables/columns)"
        },
        "clickhouse.diagnostics.bestPractices": {
          "type": "boolean",
          "default": true,
          "description": "Enable best practices checks"
        },
        "clickhouse.codeActions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code actions for SQL fixes and improvements"
        },
        "clickhouse.codeActions.quickFixes": {
          "type": "boolean",
          "default": true,
          "description": "Enable quick fixes for diagnostics"
        },
        "clickhouse.codeActions.refactorings": {
          "type": "boolean",
          "default": true,
          "description": "Enable refactoring actions"
        },
        "clickhouse.codeActions.transformations": {
          "type": "boolean",
          "default": true,
          "description": "Enable transformation actions"
        },
        "clickhouse.detect.mode": {
          "type": "string",
          "enum": [
            "off",
            "prompt",
            "auto"
          ],
          "enumDescriptions": [
            "Never change a document's language automatically.",
            "Ask before switching a .sql file to ClickHouse SQL, and remember the answer per file.",
            "Switch matching files to ClickHouse SQL without asking."
          ],
          "default": "prompt",
          "description": "What to do when a file looks like ClickHouse SQL."
        },
        "clickhouse.detect.includePlaintext": {
          "type": "boolean",
          "default": false,
          "description": "Also consider plain text files for ClickHouse SQL detection."
        },
        "clickhouse.format.registerForSqlLanguage": {
          "type": "boolean",
          "default": false,
          "description": "Offer this formatter for plain \"sql\" files too. Off by default so it does not compete with formatters for other SQL dialects."
        },
        "clickhouse.diagnostics.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "description": "How long to wait after the last edit before re-running diagnostics."
        },
        "clickhouse.completion.maxItems": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Cap the number of completion items (0 = no limit). Only raise this above 0 for very large schemas; capping the list also limits what VS Code can filter against."
        },
        "clickhouse.serverVersion": {
          "type": "string",
          "default": "auto",
          "pattern": "^(auto|\\d+(\\.\\d+)*)$",
          "markdownDescription": "ClickHouse version to target, e.g. `24.8`. Functions introduced after this version are hidden from completion. `auto` offers everything the catalog knows."
        },
        "clickhouse.diagnostics.settingsValidation": {
          "type": "boolean",
          "default": true,
          "description": "Validate names, tiers and value types inside SETTINGS clauses against the catalog."
        },
        "clickhouse.diagnostics.rules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "hint",
              "info",
              "warning",
              "error"
            ]
          },
          "markdownDescription": "Severity per lint rule, e.g. `{ \"select-star\": \"off\", \"unknown-column\": \"error\" }`. Run **ClickHouse: Show Lint Rules** for the full list."
        },
        "clickhouse.diagnostics.syntaxErrors": {
          "type": "boolean",
          "default": true,
          "description": "Report statements that cannot be parsed."
        },
        "clickhouse.semanticHighlighting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Colour tables, columns, aliases and lambda parameters from the parse tree."
        },
        "clickhouse.inlayHints.columnTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show the data type after each projected column."
        },
        "clickhouse.format.maxLineWidth": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Break long parenthesised lists that would run past this column. 0 keeps them on one line."
        },
        "clickhouse.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "ClickHouse servers to run queries against. Passwords are **not** stored here \u2014 use **ClickHouse: Set Connection Password**, which saves them to the OS credential store. Profiles are read-only unless `allowWrite` is `true`.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Name shown in the status bar and pickers."
              },
              "host": {
                "type": "string",
                "description": "Hostname. Supports ${env:VAR}."
              },
              "port": {
                "type": "number",
                "description": "Defaults to 8123 for http, 8443 for https."
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "http",
                  "https"
                ],
                "default": "http"
              },
              "user": {
                "type": "string",
                "default": "default",
                "description": "Supports ${env:VAR}."
              },
              "database": {
                "type": "string",
                "default": "default",
                "description": "Supports ${env:VAR}."
              },
              "allowWrite": {
                "type": "boolean",
                "default": false,
                "description": "Permit INSERT, DDL and other writes. Off by default."
              },
              "protected": {
                "type": "boolean",
                "default": false,
                "description": "Require the profile name to be typed before any write runs."
              },
              "settings": {
                "type": "object",
                "description": "Settings sent with every query on this profile."
              }
            }
          }
        },
        "clickhouse.query.autoLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "Rows to read for a preview query. 0 reads everything."
        },
        "clickhouse.query.maxResultRows": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "description": "Hard cap on rows pulled into the result grid. 0 removes the cap."
        },
        "clickhouse.query.maxExecutionTime": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Seconds before ClickHouse aborts a query. 0 removes the limit."
        },
        "clickhouse.query.showRunCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a Run action above each statement."
        },
        "clickhouse.schema.source": {
          "type": "string",
          "enum": [
            "connection",
            "file",
            "both"
          ],
          "enumDescriptions": [
            "Only use the schema read from the connected server.",
            "Only use the JSON schema file(s).",
            "Use both; where they describe the same table, the server wins."
          ],
          "default": "both",
          "description": "Where schema-aware IntelliSense gets its tables and columns."
        },
        "clickhouse.schema.cacheTtlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "How long a cached server schema is used before it is refreshed. 0 never refreshes automatically."
        },
        "clickhouse.schema.includeSystemDatabase": {
          "type": "boolean",
          "default": false,
          "description": "Introspect the system database too. Off by default: the bundled catalog already describes it."
        },
        "clickhouse.schema.maxTables": {
          "type": "number",
          "default": 20000,
          "minimum": 1,
          "description": "Stop introspecting a server with more tables than this."
        }
      }
    },
    "keybindings": [
      {
        "command": "clickhouse.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == 'clickhouse' || editorLangId == 'sql')"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clickhouse",
          "title": "ClickHouse",
          "icon": "images/clickhouse-plain.svg"
        }
      ]
    },
    "views": {
      "clickhouse": [
        {
          "id": "clickhouseExplorer",
          "name": "Explorer",
          "contextualTitle": "ClickHouse"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clickhouseExplorer",
        "contents": "Connect to a ClickHouse server to browse its tables and run queries.\n[Add Connection](command:clickhouse.addConnection)\nYour password is stored in the OS credential store, never in settings.\n",
        "when": "!clickhouse.hasConnections"
      },
      {
        "view": "clickhouseExplorer",
        "contents": "Choose which server to work against.\n[Select Connection](command:clickhouse.selectConnection)\n[Add Another](command:clickhouse.addConnection)\n",
        "when": "clickhouse.hasConnections && !clickhouse.hasActiveConnection"
      },
      {
        "view": "clickhouseExplorer",
        "contents": "No tables loaded yet.\n[Reload Schema](command:clickhouse.refreshExplorer)\n[Test Connection](command:clickhouse.testConnection)\n",
        "when": "clickhouse.hasActiveConnection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js",
    "package:bundle": "node esbuild.js --production",
    "package": "vsce package",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "catalog": "node scripts/generate-catalog.mjs",
    "docs:rules": "npm run compile && node scripts/generate-rule-docs.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/vsce": "^2.19.0",
    "esbuild": "^0.28.2",
