{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ClickHouse SQL",
  "scopeName": "source.sql.clickhouse",
  "fileTypes": [
    "chsql",
    "ch.sql"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#ch-data-types"
    },
    {
      "include": "#ch-engines"
    },
    {
      "include": "#ch-aggregate-functions"
    },
    {
      "include": "#ch-array-functions"
    },
    {
      "include": "#ch-string-functions"
    },
    {
      "include": "#ch-date-functions"
    },
    {
      "include": "#ch-math-functions"
    },
    {
      "include": "#ch-type-functions"
    },
    {
      "include": "#ch-conditional-functions"
    },
    {
      "include": "#ch-other-functions"
    },
    {
      "include": "#ch-keywords"
    },
    {
      "include": "#sql-keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.sql.clickhouse",
          "match": "--(.*?)$",
          "captures": {
            "0": {
              "name": "comment.line.double-dash.sql.clickhouse"
            },
            "1": {
              "name": "comment.content.line.sql.clickhouse"
            }
          }
        },
        {
          "name": "comment.block.sql.clickhouse",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.sql.clickhouse"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.sql.clickhouse"
            }
          },
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.sql.clickhouse",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sql.clickhouse"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sql.clickhouse"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sql.clickhouse",
              "match": "\\\\(?:[nrtbf\\\\'0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.double.sql.clickhouse",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sql.clickhouse"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sql.clickhouse"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sql.clickhouse",
              "match": "\\\\(?:[nrtbf\\\\'\"0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.backtick.sql.clickhouse",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sql.clickhouse"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sql.clickhouse"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sql.clickhouse",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.sql.clickhouse",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.sql.clickhouse",
          "match": "\\b\\d+([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sql.clickhouse",
          "match": "(?i)\\b(TRUE|FALSE)\\b"
        },
        {
          "name": "constant.language.null.sql.clickhouse",
          "match": "(?i)\\bNULL\\b"
        },
        {
          "name": "constant.language.sql.clickhouse",
          "match": "(?i)\\b(INF|NAN|INFINITY)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sql.clickhouse",
          "match": "(=|!=|<>|<=|>=|<|>|<=>)"
        },
        {
          "name": "keyword.operator.arithmetic.sql.clickhouse",
          "match": "(\\+|-|\\*|\\/|%|\\^)"
        },
        {
          "name": "keyword.operator.logical.sql.clickhouse",
          "match": "(?i)\\b(AND|OR|NOT|XOR)\\b"
        },
        {
          "name": "keyword.operator.word.sql.clickhouse",
          "match": "(?i)\\b(IN|NOT\\s+IN|LIKE|NOT\\s+LIKE|ILIKE|NOT\\s+ILIKE|BETWEEN|NOT\\s+BETWEEN|IS|IS\\s+NOT|EXISTS|GLOBAL\\s+IN|GLOBAL\\s+NOT\\s+IN|ALL|ANY|SOME|HAS|HASANY|HASALL)\\b"
        },
        {
          "name": "keyword.operator.pipe.sql.clickhouse",
          "match": "->|::|\\|\\||\\?"
        }
      ]
    },
    "ch-data-types": {
      "patterns": [
        {
          "name": "storage.type.sql.clickhouse",
          "match": "\\b(NATIONAL CHARACTER LARGE OBJECT|NATIONAL CHARACTER VARYING|SimpleAggregateFunction|CHARACTER LARGE OBJECT|NATIONAL CHAR VARYING|BINARY LARGE OBJECT|IntervalMicrosecond|IntervalMillisecond|IntervalNanosecond|MEDIUMINT UNSIGNED|NATIONAL CHARACTER|NCHAR LARGE OBJECT|AggregateFunction|CHAR LARGE OBJECT|CHARACTER VARYING|SMALLINT UNSIGNED|DOUBLE PRECISION|INTEGER UNSIGNED|MEDIUMINT SIGNED|TINYINT UNSIGNED|BIGINT UNSIGNED|IntervalQuarter|MultiLineString|SMALLINT SIGNED|BINARY VARYING|INTEGER SIGNED|IntervalMinute|IntervalSecond|LowCardinality|TINYINT SIGNED|BIGINT SIGNED|INT1 UNSIGNED|IntervalMonth|NATIONAL CHAR|NCHAR VARYING|CHAR VARYING|INT UNSIGNED|IntervalHour|IntervalWeek|IntervalYear|MultiPolygon|FixedString|INT1 SIGNED|IntervalDay|DateTime32|DateTime64|Decimal128|Decimal256|INT SIGNED|LineString|MEDIUMBLOB|MEDIUMTEXT|CHARACTER|Decimal32|Decimal64|MEDIUMINT|TIMESTAMP|VARBINARY|BFloat16|DateTime|Geometry|GEOMETRY|LONGBLOB|LONGTEXT|Nullable|NVARCHAR|SMALLINT|TINYBLOB|TINYTEXT|UNSIGNED|VARCHAR2|boolean|Decimal|Dynamic|Float32|Float64|INTEGER|Nothing|NUMERIC|Polygon|TINYINT|UInt128|UInt256|VARCHAR|Variant|BIGINT|BINARY|Date32|DOUBLE|Enum16|Int128|Int256|Nested|SIGNED|SINGLE|String|Time64|UInt16|UInt32|UInt64|Array|BYTEA|Enum8|FIXED|FLOAT|INET4|INET6|Int16|Int32|Int64|NCHAR|Point|Tuple|UInt8|BLOB|bool|Bool|BYTE|CHAR|CLOB|Date|Enum|ENUM|INT1|Int8|IPv4|IPv6|JSON|QBit|REAL|Ring|TEXT|Time|UUID|YEAR|BIT|DEC|INT|Map|SET)\\b"
        }
      ]
    },
    "ch-engines": {
      "patterns": [
        {
          "name": "support.class.engine.mergetree.sql.clickhouse",
          "match": "\\b(ReplicatedVersionedCollapsingMergeTree|ReplicatedAggregatingMergeTree|ReplicatedCoalescingMergeTree|ReplicatedCollapsingMergeTree|ReplicatedReplacingMergeTree|VersionedCollapsingMergeTree|ReplicatedGraphiteMergeTree|ReplicatedSummingMergeTree|AggregatingMergeTree|CoalescingMergeTree|CollapsingMergeTree|ReplicatedMergeTree|ReplacingMergeTree|GraphiteMergeTree|SummingMergeTree|MergeTree)\\b"
        },
        {
          "name": "support.class.engine.special.sql.clickhouse",
          "match": "\\b(MaterializedPostgreSQL|AzureBlobStorage|MaterializedView|EmbeddedRocksDB|DeltaLakeAzure|DeltaLakeLocal|ExecutablePool|GenerateRandom|IcebergAzure|IcebergLocal|RemoteSecure|ArrowFlight|DeltaLakeS3|Distributed|IcebergHDFS|PaimonAzure|PaimonLocal|QueryRunner|AzureQueue|Dictionary|Executable|PaimonHDFS|PostgreSQL|TimeSeries|WindowView|DeltaLake|FuzzQuery|IcebergS3|KeeperMap|StripeLog|FuzzJSON|PaimonS3|RabbitMQ|YTsaurus|FileLog|Iceberg|MongoDB|S3Queue|TinyLog|Buffer|Memory|Paimon|Remote|SQLite|Alias|Kafka|Merge|MySQL|Redis|COSN|File|HDFS|Hive|Hudi|JDBC|Join|Loop|NATS|Null|ODBC|View|GCS|Log|OSS|Set|URL|S3)\\b"
        }
      ]
    },
    "ch-aggregate-functions": {
      "patterns": [
