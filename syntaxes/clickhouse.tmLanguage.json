          "name": "support.function.aggregate.sql.clickhouse",
          "match": "(?i)\\b(timeSeriesResampleToGridWithStaleness|quantilesExactWeightedInterpolated|quantileExactWeightedInterpolated|medianExactWeightedInterpolated|quantilesInterpolatedWeighted|timeSeriesPredictLinearToGrid|quantileInterpolatedWeighted|quantilesPrometheusHistogram|stochasticLogisticRegression|timeSeriesInstantDeltaToGrid|categoricalInformationValue|exponentialTimeDecayedCount|largestTriangleThreeBuckets|quantilePrometheusHistogram|timeSeriesInstantRateToGrid|medianInterpolatedWeighted|stochasticLinearRegression|sumMapFilteredWithOverflow|distinctJSONPathsAndTypes|exponentialTimeDecayedAvg|exponentialTimeDecayedMax|exponentialTimeDecayedSum|first_value_respect_nulls|groupNumericIndexedVector|quantilesBFloat16Weighted|estimateCompressionRatio|exponentialMovingAverage|last_value_respect_nulls|maxIntersectionsPosition|quantileBFloat16Weighted|quantilesTDigestWeighted|timeSeriesIncreaseToGrid|timeSeriesLastTwoSamples|any_value_respect_nulls|quantilesExactExclusive|quantilesExactInclusive|quantilesTimingWeighted|quantileTDigestWeighted|timeSeriesChangesToGrid|firstValueRespectNulls|medianBFloat16Weighted|quantileExactExclusive|quantileExactInclusive|quantilesDeterministic|quantilesExactWeighted|quantileTimingWeighted|simpleLinearRegression|timeSeriesResetsToGrid|anyLast_respect_nulls|cramersVBiasCorrected|kolmogorovSmirnovTest|lastValueRespectNulls|medianTDigestWeighted|nonNegativeDerivative|quantileDeterministic|quantileExactWeighted|studentTTestOneSample|timeSeriesDeltaToGrid|timeSeriesDerivToGrid|anyValueRespectNulls|distinctDynamicTypes|medianTimingWeighted|timeSeriesGroupArray|timeSeriesLastToGrid|timeSeriesRateToGrid|anyLastRespectNulls|groupArrayIntersect|groupArrayMovingAvg|groupArrayMovingSum|medianDeterministic|medianExactWeighted|sequenceMatchEvents|analysisOfVariance|groupArrayInsertAt|quantilesExactHigh|sumMapWithOverflow|any_respect_nulls|deltaSumTimestamp|distinctJSONPaths|intervalLengthSum|quantileExactHigh|quantilesBFloat16|quantilesEx